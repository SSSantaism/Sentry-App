<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".MainActivity">

    <!-- Top Navigation / AppBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SENTRY"
            android:textColor="@color/tertiary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.2"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/iv_app_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_system_status_monitoring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM ONLINE"
            android:textColor="@color/secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_online"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Main Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/cl_top_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Hero Pulse Indicator Container -->
            <FrameLayout
                android:id="@+id/fl_pulse_indicator_container"
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Outer Ring -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pulse_ring_1"/>

                <!-- Middle Ring -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_pulse_ring_2"/>

                <!-- Inner Ring -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="32dp"
                    android:background="@drawable/bg_pulse_ring_3"/>

                <!-- Core Circle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="48dp"
                    android:background="@drawable/bg_pulse_core"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_compass"
                        app:tint="@color/primary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tv_monitoring_status_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONITORING\nACTIVE"
                        android:textAlignment="center"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Alert Card (Gunshot Detected) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alert_card_threat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_alert_card"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/fl_pulse_indicator_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Header Info -->
                <ImageView
                    android:id="@+id/iv_alert_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/stat_notify_error"
                    app:tint="@color/error"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_alert_title_gunshot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="GUNSHOT DETECTED"
                    android:textColor="@color/error"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/iv_alert_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_alert_icon"
                    app:layout_constraintEnd_toStartOf="@id/tv_alert_time_ago"/>

                <TextView
                    android:id="@+id/tv_alert_location_sensor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="SECTOR ZERO • SENTRY"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@id/tv_alert_title_gunshot"
                    app:layout_constraintTop_toBottomOf="@id/tv_alert_title_gunshot"
                    app:layout_constraintEnd_toStartOf="@id/tv_alert_time_ago"/>

                <TextView
                    android:id="@+id/tv_alert_time_ago"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 MINS AGO"
                    android:textColor="@color/error"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:background="#33FFB4AB"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Stats Grid (2 Columns) -->
                <LinearLayout
                    android:id="@+id/ll_stats_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_alert_location_sensor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Confidence Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#1A02170A"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONFIDENCE"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="9sp"
                            android:fontFamily="monospace"/>

                        <TextView
                            android:id="@+id/tv_confidence_score_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="94%"
                            android:textColor="@color/error"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <!-- Acoustic Profile Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#1A02170A"
                        android:padding="8dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACOUSTIC PROFILE"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="9sp"
                            android:fontFamily="monospace"/>

                        <!-- Waveform Mock Visualizer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginTop="6dp">
                            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:background="@color/error" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:background="@color/error" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@color/error" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:background="@color/error" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/error" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/error"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Recent Telemetry section header -->
            <LinearLayout
                android:id="@+id/ll_telemetry_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/cl_alert_card_threat"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/tertiary"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_telemetry_title_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT TELEMETRY"
                    android:textColor="@color/tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Telemetry logs glass panel container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_log_suara"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_panel"
                tools:listitem="@layout/item_log_suara"
                tools:itemCount="3"
                app:layout_constraintTop_toBottomOf="@id/ll_telemetry_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ── Simulation & Navigation Section ── -->
            <View
                android:id="@+id/v_divider_simulasi"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#1AFFFFFF"
                app:layout_constraintTop_toBottomOf="@id/rv_log_suara"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/ll_debug_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/v_divider_simulasi"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/on_surface_variant"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEBUG / TESTING"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Tombol simulasi notifikasi tembakan -->
            <Button
                android:id="@+id/btn_simulasi_notifikasi"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="⚠ SIMULASIKAN DETEKSI TEMBAKAN"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="@drawable/bg_btn_simulasi"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/ll_debug_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Tombol navigasi ke halaman Log Deteksi -->
            <Button
                android:id="@+id/btn_buka_log_deteksi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="BUKA LOG DETEKSI"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconTint="@color/primary"
                app:iconGravity="textStart"
                android:layout_marginBottom="32dp"
                app:layout_constraintTop_toBottomOf="@id/btn_simulasi_notifikasi"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
