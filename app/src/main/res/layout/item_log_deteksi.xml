<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Ikon indikator jenis deteksi (warning / volume) -->
    <ImageView
        android:id="@+id/iv_icon_deteksi"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="@color/error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Label kategori event: CRITICAL_EVENT / ACOUSTIC_ANOMALY -->
    <TextView
        android:id="@+id/tv_status_tembakan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CRITICAL_EVENT"
        android:textColor="@color/error"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iv_icon_deteksi"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Waktu deteksi suara -->
    <TextView
        android:id="@+id/tv_waktu_deteksi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        android:textSize="10sp"
        android:fontFamily="monospace"
        tools:text="14:23:05"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Lokasi sensor / zona deteksi -->
    <LinearLayout
        android:id="@+id/ll_lokasi_sensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_status_tembakan"
        app:layout_constraintTop_toBottomOf="@id/tv_status_tembakan">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/on_surface_variant"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tv_lokasi_sensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="Sektor Utara - Blok B"/>
    </LinearLayout>

    <!-- Badge tingkat akurasi / confidence -->
    <TextView
        android:id="@+id/tv_akurasi_tembakan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_badge_error"
        android:layout_marginTop="8dp"
        tools:text="CONF_98%"
        app:layout_constraintStart_toStartOf="@id/tv_status_tembakan"
        app:layout_constraintTop_toBottomOf="@id/ll_lokasi_sensor"/>

    <!-- Garis pemisah bawah -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_akurasi_tembakan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
